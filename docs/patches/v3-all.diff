diff --git a/scripts/ab-sm61.sh b/scripts/ab-sm61.sh
new file mode 100755
index 00000000..56db30d9
--- /dev/null
+++ b/scripts/ab-sm61.sh
@@ -0,0 +1,125 @@
+#!/bin/bash
+# sm_61 既定スイッチ集合の A/B。GPU ロック -> 本番停止 -> アームごとにエンジン起動 -> 計測 -> 本番復元 -> ロック解放
+# 使い方: scripts/ab-sm61.sh <speed|output|timing>
+set -u
+mode=${1:-speed}
+res=~/work/results/defaults
+A=${A_IMAGE:-strata:fork-9f7d977-base}
+B=${B_IMAGE:-strata:fork-sm61-defaults}
+vol=/var/lib/docker/volumes/compose_strata-data/_data
+port=${PORT:-18080}
+mkdir -p "$res"
+
+# GPU ロック（取れなければ 3 秒間隔で待つ。30 分で諦める）
+t=0
+until mkdir /tmp/strata-gpu.lock 2>/dev/null; do
+  [ $t -ge 1200 ] && { echo "GPU lock busy" >&2; exit 2; }
+  sleep 3; t=$((t+1))
+done
+echo "defaults-$mode $(date -Is)" > /tmp/strata-gpu.lock/owner
+
+restore_prod() {
+  cp ~/opt-work/prod.env ~/Strata/docker/compose/.env
+  sudo docker exec strata sh -c "strata launch --stop --preset docker >/dev/null 2>&1; strata launch --delete-preset docker" >/dev/null 2>&1
+  cd ~/Strata/docker/compose && sudo docker compose -f docker-compose.nvidia.yml -f docker-compose.override.yml up -d --force-recreate >/dev/null 2>&1
+  s=""
+  for i in $(seq 1 90); do s=$(sudo docker inspect -f "{{.State.Health.Status}}" strata 2>/dev/null); [ "$s" = healthy ] && break; sleep 10; done
+  echo "prod health: $s image: $(sudo docker inspect -f '{{.Config.Image}}' strata)"
+  PID=$(pgrep -f "strata --serve" | head -1)
+  sudo cat /proc/$PID/environ | tr "\0" "\n" | grep -E "^STRATA_" > "$res/prod-environ-$mode.txt"
+  cat "$res/prod-environ-$mode.txt"
+  sudo docker ps --format '{{.Names}} {{.Status}}'
+  if [ "$s" = healthy ] && diff -q ~/Strata/docker/compose/.env ~/opt-work/prod.env >/dev/null; then
+    rm -rf /tmp/strata-gpu.lock && echo "gpu lock released $(date -Is)" && return 0
+  fi
+  echo "gpu lock NOT released (restore failed)"; return 1
+}
+
+K=$(grep ^API_KEY= ~/opt-work/prod.env | cut -d= -f2)
+SSET=${SSET:-"ple-io=ram prefill=auto STRATA_DENSE_F32=1 spec=4 spec-min-p=0.5"}
+
+sudo docker exec strata sh -c "strata launch --stop --preset docker" >/dev/null 2>&1
+sudo docker stop -t 120 strata >/dev/null 2>&1
+for i in $(seq 1 40); do
+  used=$(nvidia-smi --query-gpu=memory.used --format=csv,noheader,nounits)
+  hp=$(awk '/HugePages_Free/{print $2}' /proc/meminfo)
+  alive=$(pgrep -f "strata --serve" | wc -l)
+  [ "$used" -lt 3000 ] && [ "$hp" -ge 20464 ] && [ "$alive" -eq 0 ] && break
+  sleep 3
+done
+echo "prod stopped: VRAM ${used} MiB, HugePages_Free ${hp}, engines ${alive}"
+
+start_arm() {   # $1 label, $2 image, $3 extra env (may be empty)
+  local label=$1 image=$2 extra=${3:-}
+  local st="$res/state-$label"
+  sudo rm -rf "$st"; sudo cp -a "$vol/state" "$st"
+  sudo docker rm -f strata-fork >/dev/null 2>&1
+  sleep 5
+  sudo docker run -d --name strata-fork --gpus all --cpuset-cpus 36-47 \
+    --ulimit memlock=-1:-1 --shm-size 2g -p 127.0.0.1:$port:8080 \
+    -e MODEL=IQ3_XXS -e FAMILY=qwen -e CONTEXT=128k -e PARALLEL=1 -e VISION=off -e TUNE=skip \
+    -e API_KEY="$K" -e STRATA_SET="$SSET" $extra \
+    -v "$vol":/data -v "$st":/data/state \
+    --restart no "$image" > "$res/docker-run-$label.log" 2>&1
+  [ $? -eq 0 ] || { cat "$res/docker-run-$label.log"; return 3; }
+  local s=""
+  for i in $(seq 1 90); do
+    s=$(sudo docker inspect -f "{{.State.Health.Status}}" strata-fork 2>/dev/null)
+    [ "$s" = healthy ] && break
+    sudo docker inspect -f "{{.State.Status}}" strata-fork 2>/dev/null | grep -q exited && break
+    sleep 5
+  done
+  echo "arm $label health=$s"
+  sudo docker logs strata-fork > "$res/docker-$label.log" 2>&1
+  grep -E "speed switches on by default|engine started" "$st/strata/launch/docker.engine.log" | tail -5 > "$res/startup-$label.txt"
+  cat "$res/startup-$label.txt"
+  [ "$s" = healthy ] || { tail -40 "$res/docker-$label.log"; return 4; }
+}
+
+bench_arm() {   # $1 label, $2 repeat
+  local label=$1 rep=${2:-4}
+  local ts=$(date +%m%d-%H%M%S)
+  STRATA_URL="http://127.0.0.1:$port" BENCH_SEED=42 STRATA_API_KEY=$K python3 ~/bench.py 4000,24000 "$rep" 256 \
+    > "$res/bench-$mode-$label-$ts.jsonl"
+  echo "bench $label:"; cat "$res/bench-$mode-$label-$ts.jsonl"
+  STRATA_URL="http://127.0.0.1:$port" STRATA_API_KEY=$K python3 ~/work/wt/defaults/scripts/answers4.py "$res/answers-$mode-$label-$ts.json" \
+    > "$res/answers-$mode-$label-$ts.out" 2>&1
+  cat "$res/answers-$mode-$label-$ts.out"
+}
+
+stop_arm() {
+  sudo docker rm -f strata-fork >/dev/null 2>&1
+  for i in $(seq 1 20); do
+    used=$(nvidia-smi --query-gpu=memory.used --format=csv,noheader,nounits)
+    [ "$used" -lt 3000 ] && break
+    sleep 3
+  done
+}
+
+case "$mode" in
+  speed)
+    start_arm A1 "$A" "" || { stop_arm; restore_prod; exit 3; }
+    bench_arm A1 4; stop_arm
+    start_arm B1 "$B" "" || { stop_arm; restore_prod; exit 3; }
+    bench_arm B1 4; stop_arm
+    start_arm A2 "$A" "" || { stop_arm; restore_prod; exit 3; }
+    bench_arm A2 4; stop_arm
+    ;;
+  output|timing)
+    start_arm A1 "$A" "-e STRATA_DECODE_TIMING=1" || { stop_arm; restore_prod; exit 3; }
+    bench_arm A1 1
+    grep -E "decode timing|window|ms" "$res/state-A1/strata/launch/docker.engine.log" | tail -60 > "$res/timing-A1.txt" || true
+    stop_arm
+    start_arm A2 "$A" "" || { stop_arm; restore_prod; exit 3; }
+    bench_arm A2 1; stop_arm
+    start_arm B1 "$B" "-e STRATA_DECODE_TIMING=1" || { stop_arm; restore_prod; exit 3; }
+    bench_arm B1 1
+    grep -E "decode timing|window|ms" "$res/state-B1/strata/launch/docker.engine.log" | tail -60 > "$res/timing-B1.txt" || true
+    stop_arm
+    ;;
+  *)
+    echo "unknown mode $mode" >&2; rm -rf /tmp/strata-gpu.lock; exit 2 ;;
+esac
+
+restore_prod || exit 5
+echo AB_ALL_OK
diff --git a/scripts/answers4.py b/scripts/answers4.py
new file mode 100644
index 00000000..d5168f24
--- /dev/null
+++ b/scripts/answers4.py
@@ -0,0 +1,38 @@
+"""固定 4 プロンプト (2K/8K/16K/24K) の greedy 回答を保存する。A/B の出力一致と A 同士の揺れを見るため。
+プロンプトは bench.py と同じ corpus と固定シードで作るので、アーム間で本文が同一になる。
+"""
+import glob, json, os, random, sys, urllib.request
+
+base = os.environ.get("STRATA_URL", "http://127.0.0.1:8080")
+key = os.environ["STRATA_API_KEY"]
+corpus = "\n\n".join(open(p, encoding="utf-8", errors="ignore").read()
+                      for p in sorted(glob.glob(os.path.expanduser("~/Strata/docs/*.md"))))
+seed_rnd = random.Random(42)   # BENCH_SEED=42 と同じ
+sizes = [2000, 8000, 16000, 24000]
+task = ("Based on the documents above, answer in one short paragraph: "
+        "what are the three most important trade-offs this system makes?")
+out = []
+for n in sizes:
+    rnd = random.Random(seed_rnd.random())
+    n_chars = int(n * 3.6)
+    start = rnd.randint(0, max(0, len(corpus) - n_chars - 1))
+    start = corpus.find("\n", start) + 1
+    prompt = corpus[start:start + n_chars] + "\n\n---\n" + task
+    req = urllib.request.Request(
+        base + "/v1/chat/completions",
+        data=json.dumps({
+            "model": "default",
+            "messages": [{"role": "user", "content": prompt}],
+            "max_tokens": 128,
+            "temperature": 0,
+            "chat_template_kwargs": {"enable_thinking": False},
+        }).encode(),
+        headers={"Authorization": f"Bearer {key}", "Content-Type": "application/json"},
+    )
+    with urllib.request.urlopen(req, timeout=1800) as res:
+        d = json.load(res)
+    out.append({"size": n, "prompt_tokens": d.get("usage", {}).get("prompt_tokens", 0),
+                "completion_tokens": d.get("usage", {}).get("completion_tokens", 0),
+                "content": d["choices"][0]["message"].get("content", "")})
+    print(f"  size {n}: prompt {out[-1]['prompt_tokens']} tok, answer {out[-1]['completion_tokens']} tok", flush=True)
+json.dump(out, open(sys.argv[1], "w", encoding="utf-8"), ensure_ascii=False, indent=1)
diff --git a/scripts/build-in-container.sh b/scripts/build-in-container.sh
new file mode 100755
index 00000000..9a3fb8bd
